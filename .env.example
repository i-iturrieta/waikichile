# Variables de entorno de waikichile.cl.
#
# Sitio 100% estático (sin backend/Worker): la única variable real es la
# base para canónicas absolutas y app/sitemap.ts.

# Ejemplo de formato (no un valor real):
#   NEXT_PUBLIC_SITE_URL=https://waikichile.cl
NEXT_PUBLIC_SITE_URL=

# 'true' únicamente en el despliegue de `main`. Gobierna el filtro de
# contenido `borrador` (ver `lib/contenido/cargar.ts`, `filtrarPublicables`)
# y `app/robots.ts`.
SITIO_PRODUCCION=
